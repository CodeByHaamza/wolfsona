# Copier en .env — ne JAMAIS commiter le .env

# Serveur
PORT=3000
NODE_ENV=development

# Origines autorisées à ouvrir une WebSocket (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# Base de données — comptes optionnels et historique des parties.
# Une partie en cours vit en mémoire côté serveur, pas ici.
DATABASE_URL=postgres://wolfsona:wolfsona@localhost:5432/wolfsona

# Secret de signature des sessions. En production : openssl rand -hex 32
SESSION_SECRET=change-moi-en-production
